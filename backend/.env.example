# --- Required ---
DATABASE_URL=postgresql://pabbar:pabbar@localhost:4712/pabbar
REDIS_URL=redis://localhost:4713
OTP_SECRET=

# --- Server ---
PORT=4711
NODE_ENV=development
FRONTEND_URL=http://localhost:4710
API_PUBLIC_URL=http://localhost:4710/api

# --- Sessions (days) ---
SESSION_TTL_DAYS=1
SESSION_REMEMBER_TTL_DAYS=30

# --- SMTP (defaults work with Mailpit from docker-compose) ---
SMTP_HOST=localhost
SMTP_PORT=4716
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pabbar <no-reply@pabbar.local>"


# --- Social login (each needs the flag = true AND its ID + secret) ---
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
