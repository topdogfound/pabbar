# --- Required ---
DATABASE_URL=postgresql://pabbar:pabbar@localhost:5433/pabbar
OTP_SECRET=

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api

# --- Sessions (days) ---
SESSION_TTL_DAYS=1
SESSION_REMEMBER_TTL_DAYS=30

# --- SMTP (defaults work with Mailpit from docker-compose) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pabbar ${SMTP_USER}"


# --- Social login (each needs the flag = true AND its ID + secret) ---
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
