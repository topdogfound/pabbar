generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OtpChannel {
  EMAIL
  SMS
}

// What a code may be used for; a code issued for one purpose never verifies another.
enum OtpPurpose {
  LOGIN
  EMAIL_CHANGE
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum RoleScope {
  PLATFORM
  ORG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id              String     @id @default(cuid())
  email           String?    @unique
  emailVerifiedAt DateTime?
  phone           String?    @unique
  phoneVerifiedAt DateTime?
  name            String?
  avatarUrl       String?
  avatarKey       String?
  dateOfBirth     DateTime?  @db.Date
  gender          Gender?
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  identities    Identity[]
  sessions      Session[]
  otpChallenges OtpChallenge[]

  memberships       Membership[]
  platformRoles     PlatformRoleAssignment[]
  impersonationRuns Session[]                @relation("Impersonator")

  // Trigram indexes for substring search in the admin user directory. The
  // pg_trgm extension itself is created in the admin_rbac migration.
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm_idx")
}

// One row per login method linked to a user (email, google, github, phone).
model Identity {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model OtpChallenge {
  id          String     @id @default(cuid())
  channel     OtpChannel
  purpose     OtpPurpose @default(LOGIN)
  destination String
  // Set for EMAIL_CHANGE: only the user who requested the code can redeem it.
  userId      String?
  codeHash    String
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channel, destination, purpose, userId, createdAt])
  @@index([userId])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String   @unique
  remember       Boolean  @default(false)
  userAgent      String?
  ip             String?
  expiresAt      DateTime
  lastUsedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  // Set when a platform operator is viewing the app as `userId`. Cascade: if the
  // operator is deleted, the impersonation session must die with them.
  impersonatorId String?

  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonator User? @relation("Impersonator", fields: [impersonatorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@index([expiresAt])
  @@index([impersonatorId])
}

// ---------------------------------------------------------------------------
// Tenancy + RBAC
//
// Permissions are code-defined strings ("users:read"); there is no table for
// them. System roles (key != null) are synced from code at startup and are
// shared by every org. Custom roles belong to one org.
// ---------------------------------------------------------------------------

model Organization {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String
  status              OrgStatus @default(ACTIVE)
  // Invitations are only accepted for these domains when non-empty.
  allowedEmailDomains String[]  @default([])
  inviteTtlDays       Int       @default(7)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships Membership[]
  roles       Role[]
  invitations Invitation[]

  @@index([createdAt, id])
}

model Membership {
  id        String           @id @default(cuid())
  orgId     String
  userId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  org   Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles MembershipRole[]

  @@unique([orgId, userId])
  // Target of MembershipRole's composite FK, so a role row can never point at
  // a membership of a different org than its own denormalised orgId.
  @@unique([id, orgId])
  @@index([userId])
  @@index([orgId, createdAt, id])
}

model MembershipRole {
  membershipId String
  // Denormalised from Membership (enforced by the composite FK) so "members per
  // role" is one indexed group-by instead of a join.
  orgId        String
  roleId       String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId, orgId], references: [id, orgId], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@id([membershipId, roleId])
  @@index([orgId, roleId])
  @@index([roleId])
}

model Role {
  id          String    @id @default(cuid())
  // Stable identifier of a system role ("org.owner"); null for custom roles.
  key         String?   @unique
  scope       RoleScope
  // Set only for custom org roles.
  orgId       String?
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org                 Organization?            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions         RolePermission[]
  platformAssignments PlatformRoleAssignment[]
  membershipRoles     MembershipRole[]
  invitations         Invitation[]

  @@unique([orgId, name])
  @@index([orgId])
}

model RolePermission {
  roleId     String
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model PlatformRoleAssignment {
  userId      String
  roleId      String
  createdAt   DateTime @default(now())
  createdById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@id([userId, roleId])
  @@index([roleId])
}

model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  roleId      String
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, email])
}

// Append-only. No foreign keys on purpose: rows must outlive the users/orgs they
// describe, so actor and target are stored as snapshots. A DB trigger (see the
// admin_rbac migration) rejects UPDATE.
model AuditLog {
  id             String   @id @default(cuid())
  at             DateTime @default(now())
  // null = platform-level event.
  orgId          String?
  actorId        String?
  actorEmail     String?
  actorName      String?
  // Set when the action was performed while impersonating `actorId`.
  impersonatorId String?
  action         String
  targetType     String?
  targetId       String?
  targetLabel    String?
  reason         String?
  metadata       Json?
  ip             String?
  userAgent      String?
  requestId      String?

  @@index([orgId, at(sort: Desc), id(sort: Desc)])
  @@index([at(sort: Desc), id(sort: Desc)])
  @@index([actorId, at(sort: Desc)])
  @@index([targetType, targetId, at(sort: Desc)])
}
