generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OtpChannel {
  EMAIL
  SMS
}

// What a code may be used for; a code issued for one purpose never verifies another.
enum OtpPurpose {
  LOGIN
  EMAIL_CHANGE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id              String     @id @default(cuid())
  email           String?    @unique
  emailVerifiedAt DateTime?
  phone           String?    @unique
  phoneVerifiedAt DateTime?
  name            String?
  avatarUrl       String?
  avatarKey       String?
  dateOfBirth     DateTime?  @db.Date
  gender          Gender?
  status         UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  identities    Identity[]
  sessions      Session[]
  otpChallenges OtpChallenge[]
}

// One row per login method linked to a user (email, google, github, phone).
model Identity {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model OtpChallenge {
  id          String     @id @default(cuid())
  channel     OtpChannel
  purpose     OtpPurpose @default(LOGIN)
  destination String
  // Set for EMAIL_CHANGE: only the user who requested the code can redeem it.
  userId      String?
  codeHash    String
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channel, destination, purpose, userId, createdAt])
  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  remember   Boolean  @default(false)
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@index([expiresAt])
}
